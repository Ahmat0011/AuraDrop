<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AuraDrop.Core.Models;assembly=AuraDrop.Core"
             x:Class="AuraDrop.AndroidApp.Views.MainPage"
             BackgroundColor="{StaticResource BackgroundDark}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top App Bar -->
        <Border Grid.Row="0" BackgroundColor="{StaticResource SurfaceDark}" Stroke="{StaticResource CardBorder}" StrokeThickness="0,0,0,1" StrokeShape="RoundRectangle 0" Padding="16,10">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Border WidthRequest="26" HeightRequest="26" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Primary}" Stroke="Transparent" VerticalOptions="Center">
                        <Path Data="M 12,3 V 15 M 7,10 L 12,15 L 17,10 M 4,17 V 19 A 2,2 0 0 0 6,21 H 18 A 2,2 0 0 0 20,19 V 17" Stroke="#080C14" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="AuraDrop" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                
                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                    <!-- History Button with Vector Path -->
                    <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="8,6" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenHistoryClicked" />
                        </Border.GestureRecognizers>
                        <Path Data="M 12,8 V 12 L 15,15 M 12,22 A 10,10 0 1 0 12,2 A 10,10 0 0 0 12,22 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" />
                    </Border>
                    <!-- Info Button with Vector Path -->
                    <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="8,6" StrokeShape="RoundRectangle 8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenInfoClicked" />
                        </Border.GestureRecognizers>
                        <Path Data="M 12,16 V 12 M 12,8 H 12.01 M 12,22 A 10,10 0 1 0 12,2 A 10,10 0 0 0 12,22 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- Center Content Views -->
        <Grid Grid.Row="1" VerticalOptions="FillAndExpand">

            <!-- ==================== VIEW 1: RECEIVE ==================== -->
            <ScrollView x:Name="ViewReceive" IsVisible="True" VerticalOptions="FillAndExpand" Padding="20,16">
                <VerticalStackLayout Spacing="22" VerticalOptions="CenterAndExpand">

                    <!-- Center Segmented Emblem -->
                    <Border WidthRequest="150" HeightRequest="150" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 0" HorizontalOptions="Center">
                        <GraphicsView x:Name="RadarCanvas" WidthRequest="150" HeightRequest="150" HorizontalOptions="Center" />
                    </Border>

                    <!-- Device Name & IP Hash -->
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label x:Name="LblCenterDeviceName" Text="Android Phone" FontSize="26" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        <Label x:Name="LblCenterDeviceHash" Text="#190" FontSize="16" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <!-- Quick Save Switch -->
                    <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 20" Padding="16,8" HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnToggleQuickSaveClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="Quick Save:" FontSize="13" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                            <Label x:Name="LblQuickSaveStatus" Text="An" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Subtle PIN Fetch Action Button -->
                    <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="16,10" HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnPromptFetchPinClicked" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="M 12,22 S 20,18 20,12 V 5 L 12,2 L 4,5 V 12 S 4,18 12,22 Z M 12,8 A 2,2 0 1 0 12,12 A 2,2 0 0 0 12,8 Z M 12,12 V 16" Stroke="{StaticResource Primary}" StrokeThickness="1.6" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Text="Per 6-stelligem PIN abholen..." FontSize="12" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Directory Hint -->
                    <Label x:Name="LblSaveDirectory" Text="Dateien werden in Downloads/AuraDrop gespeichert&#10;(100% Originalqualität ohne Komprimierung)" FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </ScrollView>

            <!-- ==================== VIEW 2: SEND ==================== -->
            <ScrollView x:Name="ViewSend" IsVisible="False" VerticalOptions="FillAndExpand" Padding="16">
                <VerticalStackLayout Spacing="16">

                    <!-- Section: Selection (Media, Text, File, Folder) -->
                    <Label Text="DATEIEN ZUM SENDEN" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                    <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="8">
                        <!-- Media Card -->
                        <Border Grid.Column="0" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickPhotosClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Path Data="M 19,3 H 5 A 2,2 0 0 0 3,5 V 19 A 2,2 0 0 0 5,21 H 19 A 2,2 0 0 0 21,19 V 5 A 2,2 0 0 0 19,3 Z M 8.5,10 A 1.5,1.5 0 1 1 8.5,7 A 1.5,1.5 0 0 1 8.5,10 Z M 21,15 L 16,10 L 5,21" Stroke="{StaticResource Primary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Medien" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Text Card -->
                        <Border Grid.Column="1" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSendTextClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Path Data="M 14,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 8 Z M 14,2 V 8 H 20 M 16,13 H 8 M 16,17 H 8 M 10,9 H 8" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Text" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- File Card -->
                        <Border Grid.Column="2" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPickFilesClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Path Data="M 13,2 H 6 A 2,2 0 0 0 4,4 V 20 A 2,2 0 0 0 6,22 H 18 A 2,2 0 0 0 20,20 V 9 Z M 13,2 V 9 H 20" Stroke="{StaticResource Primary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="Dateien" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- PIN Sharing Card -->
                        <Border Grid.Column="3" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGeneratePinClicked" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Path Data="M 12,22 S 20,18 20,12 V 5 L 12,2 L 4,5 V 12 S 4,18 12,22 Z M 12,8 A 2,2 0 1 0 12,12 A 2,2 0 0 0 12,8 Z M 12,12 V 16" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" />
                                <Label Text="PIN Code" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Selected Files Banner -->
                    <Border x:Name="BorderSelectedFiles" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource Primary}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12" IsVisible="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label x:Name="LblSelectedCount" Text="0 Dateien ausgewählt" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label x:Name="LblSelectedSize" Text="0 MB" FontSize="11" TextColor="{StaticResource Primary}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="Leeren" FontSize="11" BackgroundColor="Transparent" TextColor="{StaticResource Danger}" Clicked="OnClearFilesClicked" />
                        </Grid>
                    </Border>

                    <!-- Section: Nearby devices -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                        <Label Text="GERÄTE IM WLAN" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                            <!-- Refresh Button -->
                            <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRefreshDevicesClicked" />
                                </Border.GestureRecognizers>
                                <Path Data="M 23,4 V 10 H 17 M 1,20 V 14 H 7 M 3.51,9 A 9,9 0 0 1 18.36,5.64 L 23,10 M 1,14 L 5.64,18.36 A 9,9 0 0 0 20.49,15" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="16" HeightRequest="16" />
                            </Border>
                            <!-- Direct IP Button -->
                            <Border BackgroundColor="Transparent" Stroke="Transparent" Padding="4">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDirectIpClicked" />
                                </Border.GestureRecognizers>
                                <Path Data="M 12,2 A 10,10 0 1 0 12,22 A 10,10 0 0 0 12,2 Z M 12,6 A 6,6 0 1 0 12,18 A 6,6 0 0 0 12,6 Z M 12,10 A 2,2 0 1 0 12,14 A 2,2 0 0 0 12,10 Z" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="16" HeightRequest="16" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Nearby Devices Collection -->
                    <CollectionView x:Name="ColNearbyDevices" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:DeviceInfo">
                                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="40, *, Auto" ColumnSpacing="10">
                                        <!-- Device Icon (Computer or Phone) -->
                                        <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" BackgroundColor="{StaticResource SurfaceDark}" Stroke="Transparent" StrokeShape="RoundRectangle 8">
                                            <Path Data="M 20,3 H 4 A 2,2 0 0 0 2,5 V 15 A 2,2 0 0 0 4,17 H 20 A 2,2 0 0 0 22,15 V 5 A 2,2 0 0 0 20,3 Z M 8,21 H 16 M 12,17 V 21" Stroke="{StaticResource Primary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>

                                        <!-- Name & Badges -->
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource TextPrimary}" />
                                            <HorizontalStackLayout Spacing="6">
                                                <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="6,1">
                                                    <Label Text="{Binding IpAddress}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                                </Border>
                                                <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="6,1">
                                                    <Label Text="{Binding DeviceType}" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Send Button -->
                                        <Button Grid.Column="2" Text="Senden" FontSize="12" FontAttributes="Bold" BackgroundColor="{StaticResource Primary}" TextColor="#080C14" CornerRadius="14" Padding="14,6" Clicked="OnSendToDeviceClicked" CommandParameter="{Binding}" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty State Hint -->
                    <Label x:Name="LblNoDevices" Text="Suche nach Geräten im selben WLAN..." FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" Margin="0,14" />

                    <!-- Troubleshoot Hint -->
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" Margin="0,8,0,0">
                        <Label Text="Troubleshoot" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        <Label Text="Bitte stelle sicher, dass beide Geräte im selben WLAN sind." FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ==================== VIEW 3: SETTINGS ==================== -->
            <ScrollView x:Name="ViewSettings" IsVisible="False" VerticalOptions="FillAndExpand" Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Einstellungen" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                    <!-- Device Name -->
                    <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Gerätename (Alias im Netzwerk)" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Entry x:Name="EntryDeviceName" Text="Android Phone" BackgroundColor="{StaticResource SurfaceDark}" TextColor="{StaticResource TextPrimary}" />
                                <Button Grid.Column="1" Text="Speichern" BackgroundColor="{StaticResource Primary}" TextColor="#080C14" FontAttributes="Bold" Clicked="OnSaveDeviceNameClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Security & PIN Protection -->
                    <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout Spacing="8">
                                <Path Data="M 12,22 S 20,18 20,12 V 5 L 12,2 L 4,5 V 12 S 4,18 12,22 Z M 12,8 A 2,2 0 1 0 12,12 A 2,2 0 0 0 12,8 Z M 12,12 V 16" Stroke="{StaticResource Primary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                <Label Text="Sicherheit &amp; PIN-Schutz" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="PIN für Übertragungen erzwingen" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                    <Label Text="Andere Geräte müssen deinen PIN eingeben" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>
                                <Switch Grid.Column="1" x:Name="SwitchPinProtection" Toggled="OnPinProtectionToggled" />
                            </Grid>

                            <Label Text="Dein 6-stelliger Sicherheits-PIN:" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                <Entry x:Name="EntryPinConfig" Text="123456" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{StaticResource Primary}" BackgroundColor="{StaticResource SurfaceDark}" Keyboard="Numeric" MaxLength="6" TextChanged="OnPinConfigChanged" />
                                <Button Grid.Column="1" Text="Neu" BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource TextPrimary}" FontAttributes="Bold" Clicked="OnGenerateNewPinClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Quick Save Toggle -->
                    <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Quick Save (Auto-Akzeptieren)" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                                <Label Text="Dateien automatisch ohne Bestätigung empfangen" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" x:Name="SwitchAutoAccept" Toggled="OnAutoAcceptToggled" />
                        </Grid>
                    </Border>

                    <!-- Network Info -->
                    <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="AuraDrop P2P Transfer" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label x:Name="LblNetDetails" Text="IP: 192.168.0.x | Port: 52525" FontSize="11" TextColor="{StaticResource TextMuted}" />
                            <Label Text="Direktes P2P ohne Cloud-Server. 100% Originalqualität." FontSize="10" TextColor="{StaticResource Primary}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <!-- PIN Display Modal Overlay -->
            <Border x:Name="ModalPinDisplay" BackgroundColor="#E6000000" IsVisible="False" Padding="20">
                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="24" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Label Text="6-stelliger Transfer-PIN" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                        <Label Text="Gib diesen PIN auf dem Zielgerät ein:" FontSize="12" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Border BackgroundColor="{StaticResource SurfaceDark}" Stroke="{StaticResource Primary}" StrokeThickness="2" StrokeShape="RoundRectangle 12" Padding="24,12">
                            <Label x:Name="LblGeneratedPin" Text="000 000" FontSize="34" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                        </Border>
                        <Label Text="Warte auf Download durch Empfänger..." FontSize="11" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                        <Button Text="Schließen" BackgroundColor="{StaticResource Primary}" TextColor="#080C14" FontAttributes="Bold" CornerRadius="8" Clicked="OnClosePinModalClicked" />
                    </VerticalStackLayout>
                </Border>
            </Border>

            <!-- Live Transfer Progress Modal Overlay -->
            <Border x:Name="ModalProgress" BackgroundColor="#EE080C14" IsVisible="False" Padding="20">
                <Border BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="24" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="12">
                        <Label x:Name="LblProgressTitle" Text="Dateien werden übertragen..." FontSize="16" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        <Label x:Name="LblProgressFile" Text="Datei: 1/5" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                        <ProgressBar x:Name="ProgressTransferBar" Progress="0" ProgressColor="{StaticResource Primary}" HeightRequest="8" />
                        <Grid ColumnDefinitions="*, *, *">
                            <Label x:Name="LblProgressPercent" Text="0%" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Column="1" x:Name="LblProgressSpeed" Text="0 MB/s" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" />
                            <Label Grid.Column="2" x:Name="LblProgressEta" Text="--:--" FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalOptions="End" />
                        </Grid>
                        <Button Text="Übertragung abbrechen" BackgroundColor="{StaticResource Danger}" TextColor="White" CornerRadius="8" Margin="0,10,0,0" Clicked="OnCancelTransferClicked" />
                    </VerticalStackLayout>
                </Border>
            </Border>
        </Grid>

        <!-- ==================== MODERN DOCKED BOTTOM NAVIGATION BAR ==================== -->
        <Grid Grid.Row="2" HeightRequest="68" BackgroundColor="{StaticResource SurfaceDark}" VerticalOptions="End">
            <!-- Top Hairline Divider -->
            <BoxView HeightRequest="1" BackgroundColor="{StaticResource CardBorder}" VerticalOptions="Start" />

            <!-- Navigation Tabs (Google Pixel / Material 3 Style) -->
            <Grid ColumnDefinitions="*, *, *" VerticalOptions="Fill" HorizontalOptions="Fill" Padding="8,4,8,6">
                <!-- Tab 1: Empfangen -->
                <Grid Grid.Column="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavReceiveClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Active Pill Indicator -->
                        <Border x:Name="BorderNavReceive" BackgroundColor="{StaticResource Secondary}" Stroke="Transparent" StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                            <Path x:Name="PathNavReceive" Data="M 21,15 V 19 A 2,2 0 0 1 19,21 H 5 A 2,2 0 0 1 3,19 V 15 M 7,10 L 12,15 L 17,10 M 12,15 V 3" Stroke="{StaticResource Primary}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="LblNavReceive" Text="Empfangen" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource Primary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tab 2: Senden -->
                <Grid Grid.Column="1" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavSendClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Active Pill Indicator -->
                        <Border x:Name="BorderNavSend" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                            <Path x:Name="PathNavSend" Data="M 22,2 L 11,13 M 22,2 L 15,22 L 11,13 L 2,9 Z" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="LblNavSend" Text="Senden" FontSize="11" FontAttributes="None" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                    </VerticalStackLayout>
                </Grid>

                <!-- Tab 3: Einstellungen -->
                <Grid Grid.Column="2" HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNavSettingsClicked" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                        <!-- Active Pill Indicator -->
                        <Border x:Name="BorderNavSettings" BackgroundColor="Transparent" Stroke="Transparent" StrokeShape="RoundRectangle 16" WidthRequest="56" HeightRequest="32">
                            <Path x:Name="PathNavSettings" Data="M 12,15 A 3,3 0 1 0 12,9 A 3,3 0 0 0 12,15 Z M 19.4,15 A 1.65,1.65 0 0 0 19.73,16.82 L 19.79,16.88 A 2,2 0 0 1 16.96,19.71 L 16.9,19.65 A 1.65,1.65 0 0 0 15.08,19.32 A 1.65,1.65 0 0 0 14,20.83 V 21 A 2,2 0 0 1 10,21 V 20.91 A 1.65,1.65 0 0 0 9,19.4 A 1.65,1.65 0 0 0 7.18,19.73 L 7.12,19.79 A 2,2 0 0 1 4.29,16.96 L 4.35,16.9 A 1.65,1.65 0 0 0 4.68,15.08 A 1.65,1.65 0 0 0 3.17,14 H 3 A 2,2 0 0 1 3,10 H 3.09 A 1.65,1.65 0 0 0 4.6,9 A 1.65,1.65 0 0 0 4.27,7.18 L 4.21,7.12 A 2,2 0 0 1 7.04,4.29 L 7.1,4.35 A 1.65,1.65 0 0 0 8.92,4.68 A 1.65,1.65 0 0 0 10,3.17 V 3 A 2,2 0 0 1 14,3 V 3.09 A 1.65,1.65 0 0 0 15,4.6 A 1.65,1.65 0 0 0 16.82,4.27 L 16.88,4.21 A 2,2 0 0 1 19.71,7.04 L 19.65,7.1 A 1.65,1.65 0 0 0 19.32,8.92 A 1.65,1.65 0 0 0 20.83,10 H 21 A 2,2 0 0 1 21,14 H 20.91 A 1.65,1.65 0 0 0 19.4,15 Z" Stroke="{StaticResource TextMuted}" StrokeThickness="1.8" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label x:Name="LblNavSettings" Text="Einstellungen" FontSize="11" FontAttributes="None" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" HorizontalTextAlignment="Center" LineBreakMode="NoWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Grid>

        <!-- ==================== NATIVE MEDIA GALLERY PICKER OVERLAY ==================== -->
        <Grid x:Name="ViewMediaPicker" Grid.Row="0" Grid.RowSpan="3" BackgroundColor="{StaticResource SurfaceDark}" IsVisible="False" ZIndex="999">
            <Grid.RowDefinitions>
                <!-- Top Header (Close + Category Dropdown) -->
                <RowDefinition Height="56" />
                <!-- Media Grid -->
                <RowDefinition Height="*" />
                <!-- Bottom Confirmation Bar -->
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="48, *, 48" BackgroundColor="{StaticResource SurfaceDark}" Padding="12,6">
                <!-- Close Button 'X' -->
                <Border Grid.Column="0" BackgroundColor="Transparent" Stroke="Transparent" WidthRequest="40" HeightRequest="40" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseMediaPickerClicked" />
                    </Border.GestureRecognizers>
                    <Path Data="M 18,6 L 6,18 M 6,6 L 18,18" Stroke="{StaticResource TextPrimary}" StrokeThickness="2" Aspect="Uniform" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <!-- Category Pill Selector -->
                <Border Grid.Column="1" BackgroundColor="{StaticResource CardBackground}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="14,6" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleCategoryDropdownClicked" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label x:Name="LblCurrentCategoryTitle" Text="Alle Medien" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" VerticalOptions="Center" />
                        <Path x:Name="PathCategoryChevron" Data="M 6,9 L 12,15 L 18,9" Stroke="{StaticResource Primary}" StrokeThickness="2" Aspect="Uniform" WidthRequest="12" HeightRequest="12" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Placeholder for balance -->
                <Grid Grid.Column="2" />
            </Grid>

            <!-- Top Hairline Divider -->
            <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="{StaticResource CardBorder}" VerticalOptions="End" />

            <!-- Media Grid Container -->
            <Grid Grid.Row="1">
                <!-- Loading State -->
                <VerticalStackLayout x:Name="LayoutMediaLoading" Spacing="12" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False">
                    <ActivityIndicator IsRunning="True" Color="{StaticResource Primary}" WidthRequest="36" HeightRequest="36" />
                    <Label Text="Medien werden geladen..." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Empty State -->
                <VerticalStackLayout x:Name="LayoutMediaEmpty" Spacing="10" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="False">
                    <Path Data="M 19,3 H 5 A 2,2 0 0 0 3,5 V 19 A 2,2 0 0 0 5,21 H 19 A 2,2 0 0 0 21,19 V 5 A 2,2 0 0 0 19,3 Z" Stroke="{StaticResource TextMuted}" StrokeThickness="1.5" Aspect="Uniform" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" />
                    <Label Text="Keine Medien gefunden" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" HorizontalOptions="Center" />
                    <Label Text="Stelle sicher, dass der Medienzugriff erlaubt ist." FontSize="12" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center" />
                    <Button Text="Medien neu laden" FontSize="12" FontAttributes="Bold" BackgroundColor="{StaticResource Secondary}" TextColor="{StaticResource Primary}" CornerRadius="10" Padding="16,8" Margin="0,6,0,0" Clicked="OnReloadMediaClicked" HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- 4-Column Media Grid (LocalSend Style) -->
                <CollectionView x:Name="CvMediaGrid" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="2" VerticalItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid HeightRequest="90" WidthRequest="90" BackgroundColor="#0F172A">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnMediaGridItemTapped" />
                                </Grid.GestureRecognizers>
                                <!-- Thumbnail Image -->
                                <Image Source="{Binding ThumbnailSource}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />

                                <!-- Video Camera & Duration Badge (Bottom-Left) -->
                                <Border IsVisible="{Binding IsVideo}" BackgroundColor="#CC080C14" Stroke="Transparent" StrokeShape="RoundRectangle 4" Padding="4,2" HorizontalOptions="Start" VerticalOptions="End" Margin="4">
                                    <HorizontalStackLayout Spacing="3" VerticalOptions="Center">
                                        <Path Data="M 15,10 L 20,7 V 17 L 15,14 V 17 A 2,2 0 0 1 13,19 H 3 A 2,2 0 0 1 1,17 V 7 A 2,2 0 0 1 3,5 H 13 A 2,2 0 0 1 15,7 Z" Stroke="White" StrokeThickness="1.2" Aspect="Uniform" WidthRequest="10" HeightRequest="10" VerticalOptions="Center" />
                                        <Label Text="{Binding FormattedDuration}" FontSize="10" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Selection Circle (Top-Right) -->
                                <Border Margin="4" WidthRequest="22" HeightRequest="22" HorizontalOptions="End" VerticalOptions="Start" StrokeThickness="1.5" StrokeShape="RoundRectangle 11">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BackgroundColor" Value="#33000000" />
                                            <Setter Property="Stroke" Value="#E2E8F0" />
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                                    <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Path Data="M 20,6 L 9,17 L 4,12" Stroke="White" StrokeThickness="2.2" Aspect="Uniform" WidthRequest="12" HeightRequest="12" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="IsVisible" Value="False" />
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Category Dropdown Sheet (Overlaid on top of grid) -->
                <Border x:Name="BorderCategoryDropdown" BackgroundColor="{StaticResource SurfaceDark}" Stroke="{StaticResource CardBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 0,0,16,16" VerticalOptions="Start" HorizontalOptions="Fill" Margin="16,0,16,0" IsVisible="False" ZIndex="1000" MaximumHeightRequest="420" Padding="0,6">
                    <ScrollView VerticalScrollBarVisibility="Always">
                        <VerticalStackLayout x:Name="StackCategories" Spacing="2">
                            <!-- Dynamically generated category rows -->
                        </VerticalStackLayout>
                    </ScrollView>
                </Border>
            </Grid>

            <!-- Bottom Action Bar -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto, *, Auto" BackgroundColor="{StaticResource SurfaceDark}" Padding="16,8" VerticalOptions="End">
                <BoxView HeightRequest="1" BackgroundColor="{StaticResource CardBorder}" VerticalOptions="Start" Grid.ColumnSpan="3" />
                
                <!-- Clear Button -->
                <Button Grid.Column="0" Text="Auswahl leeren" TextColor="{StaticResource TextMuted}" BackgroundColor="Transparent" FontSize="12" Clicked="OnClearMediaPickerSelectionClicked" VerticalOptions="Center" />

                <!-- Selection Summary Text -->
                <Label Grid.Column="1" x:Name="LblMediaSelectionSummary" Text="0 ausgewählt" FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" VerticalOptions="Center" />

                <!-- Confirm Button -->
                <Button Grid.Column="2" x:Name="BtnConfirmMediaSelection" Text="Bestätigen" BackgroundColor="{StaticResource Primary}" TextColor="#080C14" FontAttributes="Bold" CornerRadius="10" Padding="20,0" HeightRequest="44" Clicked="OnConfirmMediaSelectionClicked" VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
